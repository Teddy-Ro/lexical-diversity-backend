<mxCell id="at_domain" value="&lt;b&gt;Домен авторских текстов — /api/author_texts&lt;/b&gt;&lt;hr/&gt;+GET /api/author_texts?min_text_length=…()&lt;br/&gt;+GET /api/author_texts/feed()&lt;br/&gt;+GET /api/author_texts/{author_text_id}?next=true()&lt;br/&gt;+GET /api/author_texts/draft()&lt;br/&gt;+POST /api/author_texts [multipart: название, фото, видео]()&lt;br/&gt;+PUT /api/author_texts/{author_text_id}/publish [JSON]()&lt;br/&gt;+DELETE /api/author_texts/{author_text_id}()&lt;br/&gt;+POST /api/author_texts/{author_text_id}/like [value: 0 | 1]()" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="85" width="670" height="300" as="geometry"/></mxCell>
